FROM debian:trixie-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy release binary built on the host
COPY target/release/apas-server /usr/local/bin/apas-server

# Create data directory for SQLite
RUN mkdir -p /app/data

# Expose port
EXPOSE 8080

# Set environment variables
ENV RUST_LOG=apas_server=info,tower_http=debug

# Run the server
CMD ["apas-server"]
