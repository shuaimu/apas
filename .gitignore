# Rust
/target/
**/*.rs.bk

# Node
node_modules/
packages/web/.next/
packages/web/out/
packages/web/.apas-version
packages/web/tsconfig.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local data
/data/
*.db

# Per-machine project metadata (contains unique session IDs)
.apas
# Per-project agent state (the apas binary writes these in any project
# it runs in, including this repo when we dogfood)
.apas-team.jsonl
.apas-conversations/
# Advisory lock the MCP team tools hold across team-todo.md read-modify-write.
# Untracked it would show up in `git status`, which the Tech Lead reads for
# checkout-drift detection and would escalate on.
.apas-team.lock
.apas-worktrees/
team-todo.md
suggested-workers.md
project_goal.md
# Per-agent scratchpad cursors (Tech Lead / Reviewer track where they
# last read so they don't re-process — or miss — records).
.apas-tech-lead-cursor
.apas-reviewer-cursor
.apas-developer-cursor
# Tech Lead's per-PR comment cursor (added when it took over PR
# state-tracking from Developers).
.apas-tech-lead-pr-comments.json
# Claude Code runtime state (scheduled tasks, plugins, etc.)
.claude/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Build artifacts
dist/
build/
