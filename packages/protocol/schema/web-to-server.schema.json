  "$defs": {
    "CliLifecycleOperation": {
      "description": "A project-level lifecycle operation.\n\nOnly reboot is a user decision. Transport recovery used to be a second\nvariant here, driven by a `Reconnect Server` button, and was withdrawn: the\nCLI already re-dials a lost transport on its own with bounded backoff, and a\nrequest to do so has to travel over the very transport that is down.",
      "type": "string",
      "enum": [
        "reboot_cli"
      ]
    },
    "ClientKind": {
      "type": "string",
      "enum": [
        "web",
        "mobile"
      ]
    },
    "MobileTelemetryEvent": {
      "description": "Strictly redacted mobile renderer health signals. These events contain no\nproject/session/pane identifiers or arbitrary strings by design.",
      "type": "string",
      "enum": [
        "terminal_bridge_ready",
        "terminal_bridge_rejected_message",
        "terminal_bridge_crash"
      ]
    },
    "PaneCleanupAction": {
      "description": "What to do with an isolated git worktree (and its branch) when the pane\nthat owns it is closed. Selected by the web UI before sending\n`WebToServer::RemovePane` so the CLI knows which git commands to run.\nPhase 1.1d of the swarm plan.",
      "oneOf": [
        {
          "description": "`git worktree remove --force <path>` + `git branch -D <branch>`.\nPermanently deletes work — pick only if the work is throwaway.",
          "type": "string",
          "const": "discard"
        },
        {
          "description": "`git -C <project> merge --no-ff <branch>` into the current main-worktree\nbranch, then remove the worktree + delete the branch. Errors out on\nmerge conflicts (the user resolves manually with normal git tools).",
          "type": "string",
          "const": "merge_and_remove"
        },
        {
          "description": "`git worktree remove <path>` (no --force — fails if there are\nuncommitted changes, in which case we just clear `worktree_path` and\ntell the user to clean up by hand). Branch is left alone so the user\ncan `git checkout` it for manual review.",
          "type": "string",
          "const": "leave_as_branch"
        }
      ]
    },
    "PaneKind": {
      "description": "How a pane hosts its agent process. Orthogonal to [`Provider`] (which\nbinary) and [`PaneMode`] (how autonomous).\n\n* [`PaneKind::Agent`] — the legacy/managed-team path: the CLI runs the provider\n  headlessly (`claude --print --output-format stream-json`,\n  `codex exec --json`) and parses structured events into\n  `CliToServer::StreamMessage`. Everything team-mode depends on —\n  usage counters, pane status, diffs, plan review, scratchpad\n  publishing, Tech Lead delegation — is built on those events. New\n  unmanaged panes are no longer created with this kind, but existing panes\n  remain compatible and managed team panes continue to use it.\n* [`PaneKind::Terminal`] — the pane instead hosts the provider's real\n  interactive TUI on a pty. Raw bytes flow over the dedicated\n  `Terminal*` messages and are rendered by xterm.js in the browser.\n  Nothing is parsed, so a terminal pane has none of the structured\n  integrations above and is never a delegation target. This is the normal\n  kind for new user-created Claude, Codex, and OpenCode panes.\n\n`#[serde(default)]` on `PaneConfig::kind` keeps `.apas` files written\nbefore this existed deserializing as `Agent`.",
      "type": "string",
      "enum": [
        "agent",
        "terminal"
      ]
    },
    "PaneMode": {
      "description": "Mode for a pane",
      "type": "string",
      "enum": [
        "deadloop",
        "interactive"
      ]
    },
    "PaneType": {
      "description": "Pane type for dual-pane mode (legacy - kept for backward compatibility)",
      "oneOf": [
        {
          "description": "Autonomous deadloop worker (left pane)",
          "type": "string",
          "const": "deadloop"
        },
        {
          "description": "Interactive user session (right pane)",
          "type": "string",
          "const": "interactive"
        }
      ]
    },
    "PlanReviewMode": {
      "description": "Phase 3.2a: per-pane policy for the \"editable plan checkpoint\"\nfeature. The streaming worker reads this at every turn to decide\nwhether to gate the first tool_use behind a user-approval card.",
      "oneOf": [
        {
          "description": "Hold every turn's first tool_use until the user approves.",
          "type": "string",
          "const": "always"
        },
        {
          "description": "Hold only when the turn's first tool_use is in a \"risky\" set\n(Write/Edit/Bash). Read-only tools run through.",
          "type": "string",
          "const": "risky_only"
        },
        {
          "description": "Today's behaviour: no gating.",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "Provider": {
      "description": "Provider for a pane",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "codex",
            "deepseek",
            "opencode",
            "cursor-agent"
          ]
        },
        {
          "description": "`claude-old` / `claude_old` aliases keep panes serialized before the\nstreaming-only switchover deserializing as the (now-only) Claude\nvariant. The legacy per-turn `--print` worker has been removed; all\n`Provider::Claude` panes use the long-lived stream-json worker.",
          "type": "string",
          "const": "claude"
        },
        {
          "description": "Decode-only compatibility tombstone. MiniMax is not launchable.",
          "type": "string",
          "const": "minimax",
          "deprecated": true
        },
        {
          "description": "Decode-only compatibility tombstone. GLM is not launchable.",
          "type": "string",
          "const": "glm",
          "deprecated": true
        }
      ]
    }
  }
}
