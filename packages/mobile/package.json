{
  "name": "@apas/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "smoke:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@apas/protocol": "file:../protocol",
    "@apas/terminal-web": "file:../terminal-web",
    "@expo/metro-runtime": "56.0.19",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.4",
    "base64-js": "1.5.1",
    "expo": "56.0.19",
    "expo-application": "56.0.3",
    "expo-clipboard": "56.0.4",
    "expo-constants": "56.0.23",
    "expo-crypto": "56.0.4",
    "expo-dev-client": "56.0.24",
    "expo-font": "56.0.7",
    "expo-linking": "56.0.16",
    "expo-notifications": "56.0.23",
    "expo-router": "56.2.18",
    "expo-secure-store": "56.0.4",
    "expo-sqlite": "56.0.5",
    "expo-status-bar": "56.0.4",
    "expo-updates": "56.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.8.3",
    "react-native-webview": "13.16.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "25.0.8",
    "@types/react": "19.2.18",
    "babel-preset-expo": "56.0.19",
    "eslint": "9.39.2",
    "eslint-config-expo": "56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
